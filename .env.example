# ========================================================
# Dailyba VPS Production Environment Configuration (.env)
# ========================================================

# Host Port Mapping (Aligned with End-to-End VPS Deployment Guide)
WEB_PORT=3005
API_PORT=4005

# Domain & Public API
DOMAIN_NAME=dailyba.pdfumi.com
NEXT_PUBLIC_API_URL=https://dailyba.pdfumi.com

# ACME Email for SSL Certbot
ACME_EMAIL=admin@pdfumi.com

# Security Keys (Generate strong random keys with: openssl rand -hex 32)
JWT_SECRET=replace_with_secure_random_jwt_secret_key_32bytes
ENCRYPTION_KEY=replace_with_secure_random_aes256_key_32bytes

# Google OAuth for Bank & Email Sync (Optional, configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dailyba.pdfumi.com/api/email-sync/google-callback

# Optional AI Scanner API Key (Google Gemini Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
