<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Header: App Title & Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dailyba • Daily Budget"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher_round" />
    </LinearLayout>

    <!-- Main Content: Daily Target Left -->
    <TextView
        android:id="@+id/widget_remaining_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Today Remaining"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_remaining_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Within Target"
        android:textColor="#34D399"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black" />

    <!-- Action Bar: + Quick Record & 1-Tap Scan Receipt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_quick_record_btn"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="+ Record"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_scan_receipt_btn"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary_bg"
            android:gravity="center"
            android:text="Scan Receipt"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
