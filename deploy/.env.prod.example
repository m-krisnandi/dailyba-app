# ========================================================
# Dailyba Production Environment Variables (.env)
# ========================================================

# Domain & Public URL
DOMAIN_NAME=dailyba.pdfumi.com
NEXT_PUBLIC_API_URL=https://dailyba.pdfumi.com

# ACME Email for Automatic SSL (Let's Encrypt)
ACME_EMAIL=admin@pdfumi.com

# JWT Secret for Auth Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_super_strong_jwt_secret_key_dailyba_2026

# Internal Server Port
PORT=4000
