# ========================================================
# Dailyba Production Environment Variables (.env)
# ========================================================

# Domain & Public URL
DOMAIN_NAME=dailyba.pdfumi.com
NEXT_PUBLIC_API_URL=https://dailyba.pdfumi.com

# ACME Email for Automatic SSL (Let's Encrypt)
ACME_EMAIL=admin@pdfumi.com

# JWT Secret for User Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_super_strong_jwt_secret_key_dailyba_2026

# AES-256 Encryption Key for OAuth Tokens (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=replace_this_with_a_super_strong_aes256_encryption_key_2026

# Google OAuth Credentials (for automated bank & e-wallet email tracking)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://dailyba.pdfumi.com/api/email-sync/google-callback

# Optional AI Fallback Extractor (Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Internal Server Port
PORT=4000
